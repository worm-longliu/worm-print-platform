{
  "name": "@worm-print-platform/demo-jquery",
  "version": "1.6.6",
  "private": true,
  "type": "module",
  "description": "jQuery 宿主直挂集成 @worm-print-platform/canvas 的独立示例：无打包器，一个 <script> + 一个 <link>，含浏览器预览打印、服务端 PDF、客户端静默打印",
  "scripts": {
    "sync": "node scripts/sync-assets.mjs",
    "postinstall": "node scripts/sync-assets.mjs",
    "dev": "node scripts/sync-assets.mjs && node server.mjs",
    "dev:watch": "node scripts/sync-assets.mjs && node server.mjs --watch",
    "build": "echo 本工程无构建步骤：直挂形态只产 public/vendor 两份文件",
    "preview": "node server.mjs"
  },
  "dependencies": {
    "@worm-print-platform/core": "file:../../../packages/core",
    "@worm-print-platform/canvas": "file:../../../packages/canvas",
    "@worm-print-platform/echarts": "file:../../../packages/echarts",
    "jquery": "^3.7.1"
  },
  "allowScripts": {
    "esbuild": true
  }
}
