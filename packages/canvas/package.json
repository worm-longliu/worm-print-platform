{
  "name": "@worm-print-platform/canvas",
  "version": "1.6.6",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "type": "module",
  "description": "打印模板设计器权威实现：零框架原生 Custom Elements + Shadow DOM（vue 为可选 peer，/vue3 子路径提供 Vue 3 门面）",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./browser": {
      "types": "./dist/browser-bundle.d.ts",
      "default": "./dist/canvas.js"
    },
    "./vue3": {
      "types": "./dist/vue3/index.d.ts",
      "import": "./dist/vue3/index.js",
      "require": "./dist/vue3/index.cjs"
    },
    "./style.css": "./dist/canvas.css"
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "author": "worm <liu_long_qqcom@qq.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/worm-longliu/worm-print-platform.git"
  },
  "readme": "README.md",
  "keywords": [
    "print",
    "template",
    "designer",
    "web-components",
    "custom-elements",
    "framework-agnostic"
  ],
  "scripts": {
    "styles": "node scripts/gen-styles.mjs && node scripts/gen-icons.mjs && node scripts/gen-version.mjs",
    "build": "npm run styles && vite build && vite build -c vite.bundle.config.ts && vite build -c vite.vue3.config.ts && tsc -p tsconfig.build.json && node ../../scripts/inject-license-banner.mjs dist",
    "dev": "npm run styles && vite build --watch",
    "typecheck": "npm run styles && tsc -p tsconfig.json --noEmit",
    "test": "npm run styles && vitest run",
    "pretest": "npm run typecheck"
  },
  "dependencies": {
    "@worm-print-platform/core": "^1.6.6",
    "@worm-print-platform/plugin-kit": "^1.6.6",
    "dompurify": "^3.4.12",
    "jsbarcode": "^3.12.3",
    "qrcode": "^1.5.4"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "happy-dom": "^20.10.6",
    "lucide-vue-next": "^0.577.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vitest": "^1.6.0",
    "vue": "^3.5.24"
  }
}
