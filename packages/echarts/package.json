{
  "name": "@worm-print-platform/echarts",
  "version": "1.6.6",
  "type": "module",
  "description": "兼容镜像包：源码唯一真源在 marketplace/plugins/echarts（@worm-print-platform/plugin-echarts），本包由同一源码生成，保留原包名与子路径供存量依赖方零改动使用",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "require": "./dist/node.cjs"
    },
    "./kit": {
      "types": "./dist/kit.d.ts",
      "import": "./dist/kit.js",
      "require": "./dist/kit.cjs"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "import": "./dist/ui.js",
      "require": "./dist/ui.cjs"
    },
    "./browser": {
      "types": "./dist/browser-bundle.d.ts",
      "default": "./dist/echarts.js"
    },
    "./browser/executor.iife": {
      "types": "./dist/executor.iife.global.d.ts",
      "default": "./dist/executor.iife.global.js"
    }
  },
  "files": [
    "dist"
  ],
  "wormPrint": {
    "id": "echarts",
    "i18n": {
      "dir": "dist/i18n",
      "base": "zh-CN"
    },
    "version": "1.6.6",
    "entry": "dist/marketplace.js",
    "kinds": [
      "barChart",
      "barHChart",
      "lineChart",
      "areaChart",
      "pieChart",
      "doughnutChart",
      "scatterChart",
      "radarChart",
      "funnelChart",
      "gaugeChart"
    ],
    "exportFormats": [],
    "peerDeps": {
      "@worm-print-platform/core": "^1.6.6",
      "@worm-print-platform/plugin-kit": "^1.6.6"
    }
  },
  "license": "MIT",
  "author": "worm <liu_long_qqcom@qq.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/worm-longliu/worm-print-platform.git"
  },
  "readme": "README.md",
  "keywords": [
    "print",
    "template",
    "echarts",
    "chart",
    "designer",
    "svg"
  ],
  "scripts": {
    "dev": "npm --prefix ../../marketplace/plugins/echarts run dev",
    "build": "npm --prefix ../../marketplace/plugins/echarts run build",
    "test": "npm --prefix ../../marketplace/plugins/echarts test",
    "test:watch": "npm --prefix ../../marketplace/plugins/echarts run test:watch"
  },
  "dependencies": {
    "@worm-print-platform/core": "^1.6.6",
    "@worm-print-platform/plugin-kit": "^1.6.6",
    "echarts": "^6.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "happy-dom": "^20.10.6",
    "tsup": "^8.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.9"
  }
}
